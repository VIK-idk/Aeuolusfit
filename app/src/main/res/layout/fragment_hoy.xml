<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAF9F4">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="90dp">

            <!-- Saludo -->
            <TextView
                android:id="@+id/tvSaludo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="¡Buenos días!"
                android:fontFamily="serif"
                android:textSize="36sp"
                android:textColor="#2C3329"/>

            <!-- RECYCLERVIEW HORIZONTAL DE PERFILES -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvPerfilesHoy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:clipToPadding="false"/>

            <!-- Tarjeta de Clima -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:cardCornerRadius="24dp"
                app:cardBackgroundColor="#EFEFE8"
                app:cardElevation="0dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">
                            <TextView
                                android:id="@+id/tvUbicacionClima"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Ubicación · Ahora"
                                android:textColor="#4F6342"
                                android:textSize="12sp"/>
                            <TextView
                                android:id="@+id/tvTemperaturaHoy"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="— °C"
                                android:textSize="48sp"
                                android:textColor="#2C3329"/>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:gravity="end">
                            <ImageView
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:src="@android:drawable/ic_menu_day"
                                app:tint="#4F6342"/>
                            <TextView
                                android:id="@+id/tvEstadoClima"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="Consultando clima..."
                                android:textStyle="bold"
                                android:textColor="#2C3329"/>
                            <TextView
                                android:id="@+id/tvHumedadHoy"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="💧 Humedad: — %"
                                android:textSize="12sp"
                                android:textColor="#686D65"/>
                        </LinearLayout>
                    </RelativeLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#D4D6CF"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="16dp"/>

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:id="@+id/tvMaxMinHoy"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Máx. —° · Mín. —°"
                            android:textColor="#686D65"
                            android:textSize="12sp"/>
                        <TextView
                            android:id="@+id/tvPronosticoTarde"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:text="🌧️ Tarde · Sin lluvia"
                            android:textColor="#686D65"
                            android:textSize="12sp"/>
                    </RelativeLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Tarjeta de Conjunto -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:cardCornerRadius="24dp"
                app:cardBackgroundColor="#FFFFFF"
                app:strokeWidth="1dp"
                app:strokeColor="#E0E0E0"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tu conjunto de hoy"
                            android:fontFamily="serif"
                            android:textSize="24sp"
                            android:textColor="#2C3329"/>
                        <ImageView
                            android:id="@+id/btnCompartirConjunto"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:src="@android:drawable/ic_menu_share"
                            app:tint="#4F6342"
                            android:clickable="true"
                            android:focusable="true"/>
                    </RelativeLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="16dp"
                        android:gravity="center_vertical">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="125dp"
                            android:layout_height="135dp"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="#F5F3E9">
                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:src="@drawable/armario"
                                android:scaleType="centerCrop"/>
                        </com.google.android.material.card.MaterialCardView>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:orientation="vertical">
                            <TextView
                                android:id="@+id/tvParaUsuario"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="• Para ti"
                                android:textStyle="bold"
                                android:textSize="12sp"
                                android:textColor="#4F6342"/>
                            <TextView
                                android:id="@+id/tvTituloConjunto"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Sin prendas registradas"
                                android:textSize="17sp"
                                android:textStyle="bold"
                                android:layout_marginTop="4dp"
                                android:textColor="#2C3329"/>
                            <TextView
                                android:id="@+id/tvDescripcionConjunto"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Añade ropa desde la pestaña Armario para recibir sugerencias."
                                android:textSize="13sp"
                                android:layout_marginTop="6dp"
                                android:textColor="#686D65"/>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Alerta Lluvia -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardAlertaLluvia"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        app:cardBackgroundColor="#F4E9E6"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="0dp"
                        android:clickable="true"
                        android:focusable="true">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="12dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">
                            <TextView
                                android:id="@+id/tvAlertaTexto"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="☂️  Revisando previsión meteorológica..."
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:textColor="#7D524A"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnVerConjunto"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="16dp"
                        android:text="Ver conjunto completo  →"
                        android:textAllCaps="false"
                        android:textSize="16sp"
                        app:cornerRadius="14dp"
                        app:backgroundTint="#4F6342" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Footer Status -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    app:cardCornerRadius="12dp"
                    app:cardBackgroundColor="#E8EDE4"
                    app:cardElevation="0dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="✓"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#4F6342"/>
                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/tvContadorPrendas"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Armario al día · 0 prendas"
                        android:textStyle="bold"
                        android:textColor="#2C3329"
                        android:textSize="13sp"/>
                    <TextView
                        android:id="@+id/tvEstadoSensores"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sensores sincronizados"
                        android:textColor="#686D65"
                        android:textSize="12sp"/>
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- BOTÓN FLOTANTE (FAB) PARA HABLAR CON LA IA -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabFeedbackIA"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="24dp"
        android:text="¿Cómo te sentiste hoy?"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        app:icon="@android:drawable/ic_menu_help"
        app:iconTint="#FFFFFF"
        app:backgroundTint="#4F6342"
        app:elevation="4dp"/>

</FrameLayout>