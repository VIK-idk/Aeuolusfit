<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAF9F4"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <!-- Título y Subtítulo dinámico -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Armario"
            android:fontFamily="serif"
            android:textSize="36sp"
            android:textColor="#2C3329"/>

        <TextView
            android:id="@+id/tvSubtituloArmario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Tu hogar conectado, a tu manera."
            android:textSize="15sp"
            android:textColor="#686D65"/>

        <!-- Cabecera de sección: Tus dispositivos -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tus dispositivos"
                android:textStyle="bold"
                android:textSize="15sp"
                android:textColor="#2C3329"/>

            <TextView
                android:id="@+id/tvResumenDispositivos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="2 conectados"
                android:textSize="13sp"
                android:textColor="#4F6342"/>
        </RelativeLayout>

        <!-- TARJETA 1: ARMARIO INTELIGENTE (Estado de la Puerta) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardDispositivoArmario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="24dp"
            app:strokeWidth="1dp"
            app:strokeColor="#E0E0E0"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center_vertical">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="84dp"
                    android:layout_height="84dp"
                    app:cardCornerRadius="16dp"
                    app:cardBackgroundColor="#EFEFE8"
                    app:cardElevation="0dp">
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/armario"
                        android:scaleType="centerCrop"/>
                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Armario inteligente"
                        android:textStyle="bold"
                        android:textSize="18sp"
                        android:textColor="#2C3329"/>

                    <TextView
                        android:id="@+id/tvEstadoPuerta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Estado: Cargando..."
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#4F6342"/>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- TARJETA 2: MÓDULO EXTERIOR -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardDispositivoModulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="24dp"
            app:strokeWidth="1dp"
            app:strokeColor="#E0E0E0"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="84dp"
                        android:layout_height="84dp"
                        app:cardCornerRadius="16dp"
                        app:cardBackgroundColor="#E8EDE4"
                        app:cardElevation="0dp">
                        <ImageView
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:layout_gravity="center"
                            android:src="@drawable/sello"
                            app:tint="#4F6342"/>
                    </com.google.android.material.card.MaterialCardView>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginStart="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Módulo exterior"
                            android:textStyle="bold"
                            android:textSize="18sp"
                            android:textColor="#2C3329"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- Subtarjeta de lecturas de sensores -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:cardBackgroundColor="#EFEFE8"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:weightSum="2">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">
                                <TextView
                                    android:id="@+id/tvTempModuloArmario"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="-- °C"
                                    android:textSize="28sp"
                                    android:textColor="#2C3329"/>
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Temperatura"
                                    android:textSize="12sp"
                                    android:textColor="#686D65"/>
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">
                                <TextView
                                    android:id="@+id/tvHumModuloArmario"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="-- %"
                                    android:textSize="28sp"
                                    android:textColor="#2C3329"/>
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Humedad relativa"
                                    android:textSize="12sp"
                                    android:textColor="#686D65"/>
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Botón inferior: + Conectar dispositivo -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnIrConectarDispositivo"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:text="+   Conectar dispositivo"
            android:textAllCaps="false"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#4F6342"
            app:cornerRadius="14dp"
            app:strokeWidth="1dp"
            app:strokeColor="#D4D6CF"
            app:backgroundTint="#FFFFFF"/>

    </LinearLayout>
</ScrollView>