<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent"
    android:padding="20dp"
    android:orientation="vertical">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="#FAF9F4"
        app:cardCornerRadius="28dp"
        app:cardElevation="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Icono papelera e icono cerrar -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    app:cardBackgroundColor="#F4E9E6"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp">
                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@android:drawable/ic_menu_delete"
                        app:tint="#9E473B"/>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/btnCerrarModalX"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_alignParentEnd="true"
                    android:gravity="center"
                    android:text="✕"
                    android:textSize="18sp"
                    android:textColor="#686D65"
                    android:clickable="true"
                    android:focusable="true"/>
            </RelativeLayout>

            <TextView
                android:id="@+id/tvTituloEliminarModal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="¿Eliminar el perfil de Laura?"
                android:fontFamily="serif"
                android:textSize="26sp"
                android:textColor="#2C3329"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Se eliminarán sus preferencias y recomendaciones. Esta acción no se puede deshacer."
                android:textSize="14sp"
                android:textColor="#686D65"/>

            <!-- Mini tarjeta resumen del familiar -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="#EAEFE5"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="14dp"
                    android:gravity="center_vertical">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        app:cardCornerRadius="22dp"
                        app:cardBackgroundColor="#F2E6DF"
                        app:cardElevation="0dp">
                        <TextView
                            android:id="@+id/tvInicialModal"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:text="L"
                            android:textStyle="bold"
                            android:textSize="18sp"
                            android:textColor="#2C3329"/>
                    </com.google.android.material.card.MaterialCardView>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/tvResumenNombreEdadModal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Laura · 35 años aprox."
                            android:textStyle="bold"
                            android:textSize="14sp"
                            android:textColor="#2C3329"/>
                        <TextView
                            android:id="@+id/tvResumenSensacionModal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Suele tener frío"
                            android:textSize="12sp"
                            android:textColor="#4F6342"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Botón rojo Eliminar perfil -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnConfirmarEliminarDefinitivo"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="20dp"
                android:text="Eliminar perfil"
                android:textAllCaps="false"
                android:textSize="15sp"
                android:textStyle="bold"
                app:cornerRadius="14dp"
                app:backgroundTint="#9E473B"/>

            <!-- Botón blanco Cancelar -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelarEliminarModal"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="8dp"
                android:text="Cancelar"
                android:textAllCaps="false"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#4F6342"
                app:cornerRadius="14dp"
                app:strokeWidth="1dp"
                app:strokeColor="#D4D6CF"
                app:backgroundTint="#FFFFFF"/>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>